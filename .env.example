# =====================================================================
# SISTEM INFORMASI & PANGKALAN DATA PROPERTI TOTOK WARSITO DAN REKAN (SIPPRO-TWR)
# Database & Cloud Configuration
# =====================================================================

# 1. Supabase PostGIS Database (Free-Tier Compliant)
# Isi nilai berikut jika ingin menghubungkan ke Cloud Database Supabase:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Status Penyimpanan Lokal
# Jika Supabase belum dikonfigurasi, sistem otomatis menggunakan Database JSON Lokal (data/properties.json)
USE_LOCAL_DATABASE=true
